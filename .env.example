# ========================================================
# Back2U - Email & Backend Environment Configuration
# ========================================================

# --------------------------------------------------------
# METHOD 1: Gmail SMTP via Nodemailer (RECOMMENDED & EASIEST)
# Sends to ANY recipient email (students, faculty, personal)
# 100% Free, NO custom domain required! Up to 500 emails/day.
#
# Steps:
# 1. Go to your Google Account -> Security (https://myaccount.google.com/security)
# 2. Turn on "2-Step Verification" (if not already enabled)
# 3. Visit https://myaccount.google.com/apppasswords
# 4. Generate an App Password for "Mail" (16-character code like "abcd efgh ijkl mnop")
# 5. Add both variables below in Vercel -> Project Settings -> Environment Variables:
# --------------------------------------------------------
EMAIL_USER=your_gmail_address@gmail.com
EMAIL_PASS=your_16_character_google_app_password

# --------------------------------------------------------
# METHOD 2: Resend API (https://resend.com)
# NOTE: The default 'onboarding@resend.dev' domain is restricted
# to sending ONLY to your own account email.
# To send to ANY student email, verify your own custom domain
# in Resend -> Domains and set RESEND_FROM_EMAIL:
# --------------------------------------------------------
RESEND_API_KEY=re_your_resend_api_key
RESEND_FROM_EMAIL=Back2U Campus <verify@yourverifieddomain.com>

# --------------------------------------------------------
# METHOD 3: EmailJS (Free 200 emails/month, client-side)
# Create a free account at https://www.emailjs.com:
# --------------------------------------------------------
VITE_EMAILJS_SERVICE_ID=your_emailjs_service_id
VITE_EMAILJS_TEMPLATE_ID=your_emailjs_template_id
VITE_EMAILJS_PUBLIC_KEY=your_emailjs_public_key

# --------------------------------------------------------
# METHOD 4: Supabase Backend (Optional)
# --------------------------------------------------------
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here
